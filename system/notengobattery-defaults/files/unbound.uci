config unbound
	list iface_trign		'wan'
	list iface_wan			'wan'
	list iface_wan			'wan6'
	option enabled			'1'
	option iface_lan		'lan'
	option listen_port		'10053'
	option localservice		'1'
	option manual_conf		'0'
	option num_threads		'2'
	option protocol			'default'
	option recursionn		'default'
	option resource			'default'
	option root_age			'9'
	option ttl_min			'300'
	option ttl_neg_max		'1000'
	option unbound_control	'1'
	option validator		'1'
	option validator_ntp	'1'

config zone
	list server			'149.112.112.112'
	list server			'9.9.9.9'
	list server			'2620:fe::9'
	list server			'2620:fe::fe'
	list zone_name		'.'
	option dns_assist	'0'
	option enabled		'1'
	option fallback		'0'
	option resolv_conf	'0'
	option tls_index	'dns.quad9.net'
	option tls_port		'853'
	option tls_upstream	'1'
	option zone_type	'forward_zone'

config zone
	list server			'149.112.112.11'
	list server			'9.9.9.11'
	list server			'2620:fe::11'
	list server			'2620:fe::fe:11'
	list zone_name		'.'
	option dns_assist	'0'
	option enabled		'0'
	option fallback		'0'
	option resolv_conf	'0'
	option tls_index	'dns.quad9.net'
	option tls_port		'853'
	option tls_upstream	'1'
	option zone_type	'forward_zone'

config zone
	list server			'1.0.0.1'
	list server			'1.1.1.1'
	list server			'2606:4700:4700::1001'
	list server			'2606:4700:4700::1111'
	list zone_name		'.'
	option dns_assist	'0'
	option enabled		'0'
	option fallback		'0'
	option resolv_conf	'0'
	option tls_index	'cloudflare-dns.com'
	option tls_port		'853'
	option tls_upstream	'1'
	option zone_type	'forward_zone'

config zone
	list server			'8.8.4.4'
	list server			'8.8.8.8'
	list server			'2001:4860:4860::8844'
	list server			'2001:4860:4860::8888'
	list zone_name		'.'
	option dns_assist	'0'
	option enabled		'0'
	option fallback		'0'
	option resolv_conf	'0'
	option tls_index	'dns.google'
	option tls_port		'853'
	option tls_upstream	'1'
	option zone_type	'forward_zone'

config zone
	list server			'iad.xfr.dns.icann.org'
	list server			'lax.xfr.dns.icann.org'
	list zone_name		'.'
	list zone_name		'arpa.'
	list zone_name		'in-addr.arpa.'
	list zone_name		'ip6.arpa.'
	option dns_assist	'0'
	option enabled		'0'
	option fallback		'0'
	option resolv_conf	'0'
	option url_dir		'https://www.internic.net/domain/'
	option zone_type	'auth_zone'
