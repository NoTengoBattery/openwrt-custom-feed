#!/bin/bash
#
# Problems? Suggestions? software@notengobattery.com
#

[ "0$(uci -q get system.@system[0].notengobattery)" -eq 2 ] && exit 0

. /lib/functions.sh
board=$(board_name)

case "$board" in
asus,rt-ac58u)
  DEVICE_HOSTNAME=RT-AC58U
  ;;
avm,fritzbox-4040)
  DEVICE_HOSTNAME=FritzBox-4040
  ;;
ezviz,cs-w3-wd1200g-eup)
  DEVICE_HOSTNAME=CS-W3-WD1200G-EUP
  ;;
glinet,gl-b1300)
  DEVICE_HOSTNAME=Convexa-B
  ;;
glinet,gl-s1300)
  DEVICE_HOSTNAME=Convexa-S
  ;;
linksys,ea6350v3)
  DEVICE_HOSTNAME=Civic
  ;;
linksys,ea8300 | \
  linksys,mr8300 | \
  linksys,mr9000)
  DEVICE_HOSTNAME=Dallas
  ;;
mikrotik,hap-ac2)
  DEVICE_HOSTNAME=HAP-AC2
  ;;
zbtlink,zbt-wg3526-16m)
  DEVICE_HOSTNAME=WG3526-16M
  ;;
zbtlink,zbt-wg3526-32m)
  DEVICE_HOSTNAME=WG3526-32M
  ;;
zyxel,nbg6617)
  DEVICE_HOSTNAME=NBG6617
  ;;
cwwk-cw-mbx-ad12)
  DEVICE_HOSTNAME=MBX-AD12
  ;;
*)
  logger -s -t ntb_def -p user.err "Unsupported hardware '$board'."
  ;;
esac

chsh root -s /bin/bash

uci batch <<EOI
  set system.system.conloglevel='7'
  set system.system.cronloglevel='7'
  set system.system.hostname='${DEVICE_HOSTNAME}'
  set system.system.log_file='/dev/pmsg0'
  set system.system.log_size='2048'

  set network.globals.packet_steering='2'

  set firewall.@defaults[0].synflood_protect='1'
  set firewall.@defaults[0].syn_flood='1'

  set irqbalance.irqbalance.enabled='1'

  set system.@system[0].notengobattery=2
  commit
EOI
