# Board to hostname mapping, shared by the NoTengoBattery uci-defaults
# scripts. Source this file, then call ntb_board_hostname with the board
# name; it prints the hostname and returns 0, or returns 1 for a board
# that is not listed here.
#
# When adding a device to seeds/, add it here too.

ntb_board_hostname() {
  case "$1" in
  asus,rt-ac58u) echo RT-AC58U ;;
  asus,rt-ax53u) echo RT-AX53U ;;
  avm,fritzbox-4040) echo FritzBox-4040 ;;
  cwwk-cw-mbx-ad12) echo MBX-AD12 ;;
  ezviz,cs-w3-wd1200g-eup) echo CS-W3-WD1200G-EUP ;;
  glinet,gl-b1300) echo Convexa-B ;;
  glinet,gl-s1300) echo Convexa-S ;;
  hiveton,h5000m) echo H5000M ;;
  linksys,ea6350v3) echo Civic ;;
  linksys,ea8300 | \
    linksys,mr8300 | \
    linksys,mr9000)
    echo Dallas
    ;;
  mikrotik,hap-ac2) echo HAP-AC2 ;;
  netgear,wax206) echo WAX206 ;;
  zbtlink,zbt-wg3526-16m) echo WG3526-16M ;;
  zbtlink,zbt-wg3526-32m) echo WG3526-32M ;;
  zyxel,nbg6617) echo NBG6617 ;;
  *) return 1 ;;
  esac
}
