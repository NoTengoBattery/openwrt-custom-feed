[ "0$(uci -q get system.@system[0].notengobattery)" -eq 1 ] && exit 0

. /lib/functions.sh
. /usr/libexec/ntb_board_hostname

board="$(board_name)"
DEVICE_HOSTNAME="$(ntb_board_hostname "$board")" ||
  logger -s -t ntb_def -p user.err "Unsupported hardware '$board'."

chsh root -s /bin/bash

# The system section is anonymous, so it must be addressed as @system[0].
# A named reference (system.system) throws UCI_ERR_INVAL, which uci batch
# swallows silently.
SET_HOSTNAME=""
[ -n "$DEVICE_HOSTNAME" ] &&
  SET_HOSTNAME="set system.@system[0].hostname='${DEVICE_HOSTNAME}'"

uci batch <<EOI
  set system.@system[0].conloglevel='7'
  set system.@system[0].cronloglevel='7'
  ${SET_HOSTNAME}
  set system.@system[0].log_file='/dev/pmsg0'
  set system.@system[0].log_size='2048'

  set system.@system[0].notengobattery=1
  commit
EOI
